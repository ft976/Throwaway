# Public web domain served by Caddy (HTTPS)
WEB_DOMAIN=ft97.com

# Comma-separated list of domains that can receive disposable email
DOMAINS=ft97.com

# HTTP and SMTP ports (Docker maps host port 25 -> container port 2525)
HTTP_PORT=3000
SMTP_PORT=25

# Redis 7 connection URL
REDIS_URL=redis://redis:6379

# Inbox lifetime and storage limits
INBOX_TTL_MINUTES=60
MAX_MESSAGES=50
MAX_MESSAGE_BYTES=2097152

# Optional STARTTLS certificate and key paths for SMTP
TLS_KEY_PATH=
TLS_CERT_PATH=

# Express trust proxy setting (1 when behind Caddy/reverse proxy)
TRUST_PROXY=1

# Optional abuse contact shown in the UI footer (defaults to abuse@first_domain)
ABUSE_EMAIL=

# Public & Secrets API configuration
# Generate strong random strings for production (e.g. `openssl rand -base64 32`)
INBOUND_WEBHOOK_SECRET=
ADMIN_SECRET=
API_KEY_TTL_DAYS=30

# Comma-separated CORS origins for /api and /api/v1 (leave empty for same-origin only, or * for any)
PUBLIC_API_CORS_ORIGINS=

# Free public temporary-mail relay bridge (auto | on | off)
# When auto/on, creates real internet disposable addresses (mail.tm / tempmail.lol) requiring zero API keys
PUBLIC_MAIL_RELAY=auto

# Optional JSON snapshot file path when running in memory mode (set to "none" to disable)
PERSIST_FILE=.data/throwaway-store.json

# Optional outbound SMTP relay for sending email to external domains (e.g. Gmail/Outlook)
# Leave empty to use direct MX port-25 delivery (on VPS) or internal/public relay routes
OUTBOUND_SMTP_HOST=
OUTBOUND_SMTP_PORT=587
OUTBOUND_SMTP_SECURE=false
OUTBOUND_SMTP_USER=
OUTBOUND_SMTP_PASS=
OUTBOUND_SMTP_FROM=

{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"process.env.DOMAINS=process.env.DOMAINS||'ft97.com';process.env.SMTP_PORT=process.env.SMTP_PORT||'2525';process.env.REDIS_MODE=process.env.REDIS_MODE||(process.env.REDIS_URL?'redis':'memory');require('./server/index.js').start()\"",
    "start": "node server/index.js",
    "build": "node -e \"const fs=require('fs'),cp=require('child_process');['server','tests'].forEach(d=>fs.readdirSync(d).filter(f=>f.endsWith('.js')).forEach(f=>cp.execFileSync(process.execPath,['--check',d+'/'+f])));cp.execFileSync(process.execPath,['--check','public/app.js']);\"",
    "lint": "eslint server public tests",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.2.1",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "dotenv": "^18.0.10",
    "express": "4",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.553.0",
    "mailparser": "^3.14.3",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "nodemailer": "^10.5.0",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sanitize-html": "^2.18.2",
    "smtp-server": "^3.21.4",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "globals": "^17.14.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
